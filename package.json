{
  "name": "auxo",
  "productName": "Auxo",
  "version": "0.2.39",
  "description": "Auxo — 나를 알아가고, 필요할 때 도와주는 AI 친구. 설치형 데스크톱 앱. 데이터 폴더는 dev·배포 모두 %APPDATA%/Auxo (productName 기준).",
  "main": "main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node cli.js",
    "bot": "node bot-telegram.js",
    "prepare-model": "node prepare-model.js",
    "pack": "npm run prepare-model && electron-builder --dir",
    "dist": "npm run prepare-model && electron-builder"
  },
  "keywords": [],
  "author": "Auxo",
  "license": "MIT",
  "build": {
    "appId": "com.auxo.app",
    "productName": "Auxo",
    "asar": true,
    "asarUnpack": [
      "models/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/node-sqlite3-wasm/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/*.node"
    ],
    "icon": "icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!evidence/**",
      "!release-staging/**",
      "!**/*-test.js",
      "!test-*.js",
      "!smoke*.js",
      "!mcp-spike*.js",
      "!roundtrip-test.js",
      "!verify-dist.js",
      "!release.js",
      "!notice.json",
      "!uninstall-template.bat",
      "!.patch-backup-*/**",
      "!audit-*.js",
      "!live-verify.js",
      "!diag-*.js",
      "!gui-seed.js",
      "!gui-drive.js",
      "!prepare-model.js",
      "!verify-branding.js",
      "!verify-package.js",
      "!verify-updatable.js",
      "!_*",
      "!app-*.js",
      "!cli-run-*.js",
      "!measure-*.js",
      "!*.err",
      "!dist-readme.txt",
      "!README.md",
      "!app-chat.js",
      "!mcp-servers.json",
      "!maker-config.js",
      "!skills/**",
      "!audit-ship-content.js",
      "!audit-dead-files.js",
      "!.playwright-mcp/**",
      "!MAC-BUILD.md",
      "!RELEASE-ASSETS.md",
      "!landing-*.png",
      "!~/**",
      "!바탕화면/**",
      "!Desktop/**",
      "!*.bak-*",
      "!_migtest.js",
      "!*-api-key",
      "!*-key",
      "!*-token",
      "!office-token",
      "!.env",
      "!*api-key*.txt",
      "!*api_key*",
      "!*apikey*",
      "!*_key.txt",
      "!*-key.txt",
      "!gemini-api-key.txt",
      "!cli-test-*/**",
      "!*-test-*/**",
      "!smoke-data/**",
      "!_t/**",
      "!*.분신.json",
      "!*.backup-*.json",
      "!**/*.log",
      "!_t/**",
      "!**/onnxruntime-web/**",
      "!**/@huggingface/transformers/.cache/**",
      "!**/onnxruntime-node/bin/napi-v6/darwin/**",
      "!**/onnxruntime-node/bin/napi-v6/linux/**",
      "!**/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!**/onnxruntime-node/**/DirectML.dll",
      "!**/onnxruntime-node/**/dxcompiler.dll",
      "!**/onnxruntime-node/**/dxil.dll",
      "!docs-*.js",
      "!codex-*.js",
      "!check-node-gate*.js",
      "!detach-run.js",
      "!mcp-stdio-probe.js",
      "!check-auto-memory.js",
      "!check-*.js",
      "!run-*.js",
      "!probe-*.js",
      "!*.out",
      "!*.err2",
      "!publish-release.js",
      "!verify-public-words.js",
      "!sync-*.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "getauxo",
        "repo": "auxo-app"
      }
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "discord.js": "^14.27.0",
    "electron-updater": "^6.8.9",
    "node-sqlite3-wasm": "^0.8.59",
    "ogg-opus-decoder": "^1.7.3",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.3",
    "dotenv": "^17.4.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  }
}
